    "gitbook-plugin-auto-scroll-table": "0.0.5",
    "gitbook-plugin-click-reveal": "1.0.0",
    "gitbook-plugin-code": "0.1.0",
    "gitbook-plugin-expandable-chapters-small": "0.1.7",
