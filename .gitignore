# Only the note sources and publishing configuration belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/.pages.yml
!/.github/
!/package.json
!/package-lock.json
!/README.md
!/sync-notes.cmd
!/publish-notes.cmd
!/scripts/
!/plugins/
!/markdownsFile/
!/markdownsFile2/
/markdownsFile/*
!/markdownsFile/book.json
!/markdownsFile/startBuild.sh
!/markdownsFile/markdownsFiles/
/markdownsFile2/*
!/markdownsFile2/book.json
!/markdownsFile2/startBuild2.sh
!/markdownsFile2/markdownsFiles/
**/node_modules/
**/_book/
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.stackdump
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/.git/
